rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && (getUserData().status == 'active' || !('status' in getUserData()));
    }

    function isWorkspaceAdmin() {
      return isActiveUser() && getUserData().role == 'workspace_admin';
    }

    function isProjectLead() {
      return isActiveUser() && getUserData().role == 'project_lead';
    }

    function isViewer() {
      return isActiveUser() && getUserData().role == 'viewer';
    }

    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isActiveUser() && (
        isWorkspaceAdmin() || 
        request.auth.uid in project.memberIds
      );
    }

    function isProjectOwner(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isActiveUser() && (
        isWorkspaceAdmin() || 
        request.auth.uid == project.ownerId
      );
    }

    function isValidAssignee(projectId, assigneeId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      let assignee = get(/databases/$(database)/documents/users/$(assigneeId)).data;
      return assigneeId == null || (
        assigneeId in project.memberIds &&
        (assignee.status == 'active' || !('status' in assignee)) &&
        assignee.role != 'workspace_admin' &&
        assignee.role != 'viewer' &&
        (assignee.role == 'member' || assignee.role == 'project_lead')
      );
    }

    function isValidReviewer(projectId, reviewerId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      let reviewer = get(/databases/$(database)/documents/users/$(reviewerId)).data;
      return reviewerId != null &&
        (reviewerId in project.memberIds || reviewer.role == 'workspace_admin' || reviewerId == project.ownerId) &&
        (reviewer.status == 'active' || !('status' in reviewer)) &&
        reviewer.role != 'viewer';
    }

    // Collection: Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only workspace admin can create, update, or terminate user accounts
      allow write: if isWorkspaceAdmin();
    }

    // Collection: Workspaces
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow write: if isWorkspaceAdmin();
    }

    // Collection: Projects
    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if isWorkspaceAdmin() || isProjectLead();
      allow update: if isWorkspaceAdmin() || isProjectOwner(projectId);
      allow delete: if isWorkspaceAdmin() || isProjectLead();
    }

    // Collection: Tasks
    match /tasks/{taskId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isProjectMember(request.resource.data.projectId) && (isWorkspaceAdmin() || isProjectLead()) &&
        isValidAssignee(request.resource.data.projectId, request.resource.data.assigneeId) &&
        isValidReviewer(request.resource.data.projectId, request.resource.data.reviewerId);
      allow update: if isProjectMember(resource.data.projectId) && !isViewer() &&
        // Cannot jump directly from in_progress to done
        !(resource.data.status == 'in_progress' && request.resource.data.status == 'done') &&
        // Self-review policy: assigned member cannot approve task to done
        !(request.resource.data.status == 'done' && resource.data.status == 'in_review' && resource.data.assigneeId == request.auth.uid) &&
        (
          request.resource.data.assigneeId == resource.data.assigneeId ||
          isValidAssignee(resource.data.projectId, request.resource.data.assigneeId)
        ) && (
          request.resource.data.reviewerId == resource.data.reviewerId ||
          isValidReviewer(resource.data.projectId, request.resource.data.reviewerId)
        );
      allow delete: if isWorkspaceAdmin() || isProjectOwner(resource.data.projectId);
    }

    // Collection: Activity Logs
    match /activity_logs/{logId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if isProjectMember(request.resource.data.projectId) && !isViewer();
      allow update, delete: if false; // Append-only immutable log
    }

    // Collection: Push Subscriptions (Native Web Push VAPID)
    match /push_subscriptions/{subId} {
      // User can only view, create, and delete their own push subscriptions
      allow read, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
    }

    // Collection: Notifications (Message Center Inbox)
    match /notifications/{notifId} {
      // Recipients only have access to their personal message inbox
      allow read, update: if isAuthenticated() && request.auth.uid == resource.data.recipientUserId;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.recipientUserId;
    }

    // Collection: Direct Messages
    match /direct_messages/{messageId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.senderId);
      allow create: if isActiveUser() && request.auth.uid == request.resource.data.senderId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.recipientId; // mark read
      allow delete: if false;
    }
  }
}
