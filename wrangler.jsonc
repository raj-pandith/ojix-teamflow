{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ojix-teamflow",
  "main": "server/cloudflareWorker.ts",
  "compatibility_date": "2026-10-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
