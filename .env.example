# OJIX TeamFlow Environment Configuration (Template)
# Note: Zero production credentials should be committed.
# Local execution defaults to the hybrid persistence engine (fallback or local emulator).

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=ojix-teamflow-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ojix-teamflow-demo
VITE_FIREBASE_STORAGE_BUCKET=ojix-teamflow-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099

# Native Web Push (VAPID) Configuration
# Public key is accessible by frontend (starts with VITE_)
VITE_VAPID_PUBLIC_KEY=BKNdlGALj-gJ2hcGKNgGstIbXdKPnfgWBnqIhMxCYSZsIwRdOAvHE0NsVI8O-a_h2tc2j69o-Qt_J6Y4xrL_FDg

# Server-only secrets (Never expose to client or prefix with VITE_)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@ojix.local

