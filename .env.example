# =============================================================================
# OJIX TeamFlow — Environment Configuration Template
# =============================================================================
# SECURITY NOTICE: Never commit real credentials or private keys to source control.
# Template contains only safe placeholders for development and deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RENDER BACKEND PRODUCTION CONFIGURATION (Server-Side Only)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Allowed CORS origins (comma-separated if multiple, e.g. Cloudflare Pages / Workers URL)
CLIENT_ORIGIN=https://ojix-teamflow.rajpandith1945.workers.dev

# Firebase Project Configuration
FIREBASE_PROJECT_ID=ojix-teamflow

# Service Account Credentials (OPTION A: Minified JSON string or Base64 string in env var - Recommended on Render)
# Format: {"type":"service_account","project_id":"ojix-teamflow","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@ojix-teamflow.iam.gserviceaccount.com",...}
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ojix-teamflow","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_HERE\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxx@ojix-teamflow.iam.gserviceaccount.com"}

# Service Account File Path (OPTION B: If deploying credentials as a secret file)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Strict persistence flag (Ensures zero silent fallbacks to local JSON in production)
STRICT_PERSISTENCE=true

# Server-only Web Push secrets
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=BKNdlGALj-gJ2hcGKNgGstIbXdKPnfgWBnqIhMxCYSZsIwRdOAvHE0NsVI8O-a_h2tc2j69o-Qt_J6Y4xrL_FDg
VAPID_SUBJECT=mailto:admin@ojix.local

# OJIX ClientFlow CRM Gateway Configuration (Server-Side Only)
# API key used by backend to fetch won deals from OJIX ClientFlow CRM
CLIENTFLOW_CRM_API_KEY=ojix-teamflow-clientflow-2026
CLIENTFLOW_CRM_API_URL=https://client-flow-5xb8.vercel.app/api/projects?stage=WON

# -----------------------------------------------------------------------------
# 2. CLOUDFLARE FRONTEND CONFIGURATION (Vite Client-Side Build)
# -----------------------------------------------------------------------------
# Points the Cloudflare Vite frontend to the Render backend origin:
VITE_API_URL=https://ojix-teamflow.onrender.com

# Public VAPID push key for browser subscription
VITE_VAPID_PUBLIC_KEY=BKNdlGALj-gJ2hcGKNgGstIbXdKPnfgWBnqIhMxCYSZsIwRdOAvHE0NsVI8O-a_h2tc2j69o-Qt_J6Y4xrL_FDg

# -----------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT & FIREBASE EMULATOR CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_HOST=localhost:8080
